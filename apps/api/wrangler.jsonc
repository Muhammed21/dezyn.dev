{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dezyn-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "api.dezyn.dev", "custom_domain": true }],
  "triggers": { "crons": ["*/15 * * * *"] },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "ed807e2d1a7e437f9a17bb749123c6d2" }],
  "vars": {
    "BETTER_AUTH_URL": "https://api.dezyn.dev",
    "WEB_URL": "https://app.dezyn.dev",
    "MAIL_FROM": "no-reply@dezyn.dev",
  },
  "durable_objects": {
    "bindings": [
      { "name": "PROJECT_ROOMS", "class_name": "ProjectRoom", "script_name": "dezyn-realtime" },
    ],
  },
  "observability": { "enabled": true },
  "env": {
    "preview": {
      "routes": [],
      "triggers": { "crons": [] },
      "hyperdrive": [],
      "workers_dev": true,
      "preview_urls": true,
      "vars": { "EMAIL_DELIVERY": "log" },
      "durable_objects": {
        "bindings": [
          {
            "name": "PROJECT_ROOMS",
            "class_name": "ProjectRoom",
            "script_name": "dezyn-realtime-preview",
          },
        ],
      },
    },
  },
}
